From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Build System <build@example.com>
Date: Thu, 19 Feb 2026 01:45:00 +0000
Subject: [PATCH] arm64: dts: rockchip: rk3528-rock-2f: set PCIe skip-reset
 in config path

On ROCK 2F, forcing default link-up can still allow early config-space
accesses to hang on an empty slot. Use the vendor skip-reset path instead,
which is safer on this board for no-endpoint boot.

Signed-off-by: Build System <build@example.com>
---
 arch/arm64/boot/dts/rockchip/rk3528-rock-2f.dts | 1 +
 1 file changed, 1 insertion(+)

diff --git a/arch/arm64/boot/dts/rockchip/rk3528-rock-2f.dts b/arch/arm64/boot/dts/rockchip/rk3528-rock-2f.dts
--- a/arch/arm64/boot/dts/rockchip/rk3528-rock-2f.dts
+++ b/arch/arm64/boot/dts/rockchip/rk3528-rock-2f.dts
@@ -415,6 +415,7 @@
 &pcie2x1 {
 	reset-gpios = <&gpio1 RK_PA2 GPIO_ACTIVE_HIGH>;
 	vpcie3v3-supply = <&vcc3v3_pcie20>;
+	rockchip,skip-reset-in-config;
 	status = "okay";
 };
 
-- 
2.20.1
